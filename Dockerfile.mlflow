FROM python:3.11.16-slim-bookworm

ARG APP_UID=1000
ARG APP_GID=1000
ARG MLFLOW_VERSION=3.10.1
ARG PSYCOPG2_BINARY_VERSION=2.9.13

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${APP_GID}" mlflow \
    && useradd \
        --create-home \
        --uid "${APP_UID}" \
        --gid "${APP_GID}" \
        mlflow

WORKDIR /opt/mlflow

RUN python -m pip install \
        "mlflow==${MLFLOW_VERSION}" \
        "psycopg2-binary==${PSYCOPG2_BINARY_VERSION}" \
    && mkdir -p /opt/mlflow/artifacts \
    && chown -R mlflow:mlflow /opt/mlflow

ENV GIT_PYTHON_REFRESH=quiet

USER mlflow

EXPOSE 5000

HEALTHCHECK \
    --interval=10s \
    --timeout=5s \
    --start-period=20s \
    --retries=12 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/version', timeout=3)"]

ENTRYPOINT ["/usr/bin/tini", "--", "mlflow"]

CMD ["server", "--host", "0.0.0.0", "--port", "5000"]